@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix llo: <http://trustgraph.ai/ontologies/lithuanian-legal#> .
@prefix lld: <http://trustgraph.ai/data/lithuanian-legal#> .

# =================================================================
# ABox Instances extracted from:
#   Lithuanian Cybersecurity Law (Kibernetinio Saugumo Įstatymas)
#   No. XII-1428, enacted 2014-12-11, Vilnius
# =================================================================


# =================================================================
# SECTION 1: THE STATUTE
# =================================================================

lld:XII-1428 a llo:Statute ;
    rdfs:label "Cybersecurity Law No. XII-1428" ;
    rdfs:label "Cybersecurity Law No. XII-1428"@en ;
    rdfs:label "Kibernetinio saugumo įstatymas Nr. XII-1428"@lt ;
    rdfs:comment "Lithuanian national cybersecurity law establishing the institutional framework, obligations, and enforcement mechanisms for cybersecurity governance." ;
    rdfs:comment "Lithuanian national cybersecurity law establishing the institutional framework, obligations, and enforcement mechanisms for cybersecurity governance."@en ;
    rdfs:comment "Lietuvos nacionalinis kibernetinio saugumo įstatymas, nustatantis institucinę struktūrą, pareigas ir vykdymo užtikrinimo mechanizmus kibernetinio saugumo valdymui."@lt ;
    llo:hasDocID "No. XII-1428" ;
    llo:dateEnacted "2014-12-11"^^xsd:date ;
    llo:isPubliclyDisclosed true ;
    llo:hasComponent lld:XII-1428_Ch1 ,
                     lld:XII-1428_Ch2 ,
                     lld:XII-1428_Ch3 ,
                     lld:XII-1428_Ch4 ,
                     lld:XII-1428_Ch5 ;
    llo:guaranteesRightTo lld:Right_NonDiscrimination ,
                          lld:Right_Proportionality ,
                          lld:Right_PublicInterest .


# =================================================================
# SECTION 2: DOCUMENT STRUCTURE – CHAPTERS
# =================================================================

lld:XII-1428_Ch1 a llo:Chapter ;
    rdfs:label "Chapter I – General Provisions" ;
    rdfs:label "Chapter I – General Provisions"@en ;
    rdfs:label "I skyrius – Bendrosios nuostatos"@lt ;
    rdfs:comment "Defines the law's scope, key terms, and foundational cybersecurity principles." ;
    rdfs:comment "Defines the law's scope, key terms, and foundational cybersecurity principles."@en ;
    rdfs:comment "Apibrėžia įstatymo taikymo sritį, pagrindines sąvokas ir kibernetinio saugumo principus."@lt ;
    llo:hasIndexNumber 1 ;
    llo:hasComponent lld:XII-1428_Art1 ,
                     lld:XII-1428_Art2 ,
                     lld:XII-1428_Art3 .

lld:XII-1428_Ch2 a llo:Chapter ;
    rdfs:label "Chapter II – Cybersecurity Policy Formation and Implementation" ;
    rdfs:label "Chapter II – Cybersecurity Policy Formation and Implementation"@en ;
    rdfs:label "II skyrius – Kibernetinio saugumo politikos formavimas ir įgyvendinimas"@lt ;
    rdfs:comment "Establishes the institutional framework for cybersecurity policy, defining powers and responsibilities of state authorities." ;
    rdfs:comment "Establishes the institutional framework for cybersecurity policy, defining powers and responsibilities of state authorities."@en ;
    rdfs:comment "Nustato institucinę kibernetinio saugumo politikos struktūrą, apibrėžia valstybės institucijų įgaliojimus ir atsakomybes."@lt ;
    llo:hasIndexNumber 2 ;
    llo:hasComponent lld:XII-1428_Art4 ,
                     lld:XII-1428_Art5 ,
                     lld:XII-1428_Art6 ,
                     lld:XII-1428_Art7 ,
                     lld:XII-1428_Art8 ,
                     lld:XII-1428_Art9 ,
                     lld:XII-1428_Art10 ,
                     lld:XII-1428_Art11 ,
                     lld:XII-1428_Art12 .

lld:XII-1428_Ch3 a llo:Chapter ;
    rdfs:label "Chapter III – Duties of Cybersecurity Participants" ;
    rdfs:label "Chapter III – Duties of Cybersecurity Participants"@en ;
    rdfs:label "III skyrius – Kibernetinio saugumo dalyvių pareigos"@lt ;
    rdfs:comment "Mandatory obligations for public entities, critical infrastructure operators, telecom providers, and hosting providers." ;
    rdfs:comment "Mandatory obligations for public entities, critical infrastructure operators, telecom providers, and hosting providers."@en ;
    rdfs:comment "Privalomosios pareigos viešojo administravimo subjektams, ypatingos svarbos infrastruktūros valdytojams, ryšių ir prieglobos paslaugų teikėjams."@lt ;
    llo:hasIndexNumber 3 ;
    llo:hasComponent lld:XII-1428_Art13 ,
                     lld:XII-1428_Art14 ,
                     lld:XII-1428_Art15 ,
                     lld:XII-1428_Art16 .

lld:XII-1428_Ch4 a llo:Chapter ;
    rdfs:label "Chapter IV – Inter-Institutional Cooperation, Information Exchange, and Accountability" ;
    rdfs:label "Chapter IV – Inter-Institutional Cooperation, Information Exchange, and Accountability"@en ;
    rdfs:label "IV skyrius – Tarpinstitucinis bendradarbiavimas, informacijos pasikeitimo tvarka ir atsakomybė"@lt ;
    rdfs:comment "Establishes the cybersecurity information network, inter-agency cooperation rules, and administrative liability for violations." ;
    rdfs:comment "Establishes the cybersecurity information network, inter-agency cooperation rules, and administrative liability for violations."@en ;
    rdfs:comment "Nustato kibernetinio saugumo informacinį tinklą, tarpžinybinio bendradarbiavimo taisykles ir administracinę atsakomybę už pažeidimus."@lt ;
    llo:hasIndexNumber 4 ;
    llo:hasComponent lld:XII-1428_Art17 ,
                     lld:XII-1428_Art18 ,
                     lld:XII-1428_Art19 .

lld:XII-1428_Ch5 a llo:Chapter ;
    rdfs:label "Chapter V – Final Provisions" ;
    rdfs:label "Chapter V – Final Provisions"@en ;
    rdfs:label "V skyrius – Baigiamosios nuostatos"@lt ;
    rdfs:comment "Entry into force and implementation deadlines for the law and its subordinate legislation." ;
    rdfs:comment "Entry into force and implementation deadlines for the law and its subordinate legislation."@en ;
    rdfs:comment "Įstatymo įsigaliojimo data ir poįstatyminių teisės aktų priėmimo terminai."@lt ;
    llo:hasIndexNumber 5 ;
    llo:hasComponent lld:XII-1428_Art20 .


