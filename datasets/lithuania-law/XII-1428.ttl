    rdfs:label "Article 10 – National Cyber Security Centre" ;
    rdfs:label "Article 10 – National Cyber Security Centre"@en ;
    rdfs:label "10 straipsnis – Nacionalinis kibernetinio saugumo centras"@lt ;
    llo:hasIndexNumber 10 ;
