    rdfs:label "2 straipsnis – 8 straipsnio pakeitimas (NKSC įgaliojimai)"@lt ;
    llo:hasIndexNumber 2 ;
    llo:codifiesConcept lld:Concept_NKSC_EnhancedEnforcement ,
                        lld:Concept_NKSC_48h_ServiceRestriction .

