    rdfs:label "Article 3 – Amendment of Article 10 (Court Sanctions and Data Preservation)" ;
    rdfs:label "Article 3 – Amendment of Article 10 (Court Sanctions and Data Preservation)"@en ;
    rdfs:label "3 straipsnis – 10 straipsnio pakeitimas (teismo sankcijos ir duomenų saugojimas)"@lt ;
    llo:hasIndexNumber 3 ;
