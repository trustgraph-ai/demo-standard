@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix hw:  <https://trustgraph.ai/ontology/hwsec/hw#> .
@prefix sec: <https://trustgraph.ai/ontology/hwsec/sec#> .


# ─────────────────────────────────────────────────────────────────
#  Ontology header
# ─────────────────────────────────────────────────────────────────

<https://trustgraph.ai/ontology/hwsec/>
    a owl:Ontology ;
    dcterms:title        "Hardware Security Decomposition Ontology" ;
    dcterms:description  "An OWL 2 DL ontology for hierarchical decomposition of hardware systems to support security research. Covers structural decomposition (System → Subsystem → Component → SubComponent → Element), cross-cutting hardware concepts (Interface, Firmware, TrustBoundary), and security annotations (AttackSurface, DebugAccess, Vulnerability, Countermeasure). Aligned to UCO, MITRE ATT&CK, D3FEND, CWE/CVE, and CPE." ;
    dcterms:creator      "Hardware Security Research Community" ;
    dcterms:license      <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionIRI       <https://trustgraph.ai/ontology/hwsec/1.0.0/> ;
    owl:versionInfo      "1.0.0" ;
    vann:preferredNamespacePrefix "hw" ;
    vann:preferredNamespaceUri    "https://trustgraph.ai/ontology/hwsec/hw#" .


# ─────────────────────────────────────────────────────────────────
#  PART 1 — DECOMPOSITION HIERARCHY  (hw: namespace)
# ─────────────────────────────────────────────────────────────────

# ── hw:HardwareEntity  (abstract root) ──────────────────────────

hw:HardwareEntity
    a owl:Class ;
    rdfs:label   "Hardware entity" ;
    rdfs:comment "Abstract superclass of every node in the decomposition tree. Do not instantiate directly; use one of the five concrete levels: System, Subsystem, Component, SubComponent, or Element." ;
    rdfs:subClassOf owl:Thing .

# ── hw:System ───────────────────────────────────────────────────

hw:System
    a owl:Class ;
    rdfs:label    "System" ;
    rdfs:comment  "The complete device or product under assessment. Root of the decomposition tree. One instance per assessment scope." ;
    rdfs:subClassOf hw:HardwareEntity ;
    skos:example  "Smartphone, home router, ICS PLC, network switch, HSM, smart TV, automotive ECU." .

# ── hw:Subsystem ────────────────────────────────────────────────

hw:Subsystem
    a owl:Class ;
    rdfs:label   "Subsystem" ;
    rdfs:comment "A functional grouping of components within a System. Subsystems correspond to major architectural partitions — typically aligned with power domains, security domains, or functional roles." ;
    rdfs:subClassOf hw:HardwareEntity ;
    skos:example "Compute subsystem, storage subsystem, radio subsystem, power management, baseband, display subsystem." .

# ── hw:Component ────────────────────────────────────────────────

hw:Component
    a owl:Class ;
    rdfs:label   "Component" ;
    rdfs:comment "A discrete physical or logical unit within a Subsystem. Typically corresponds to a single IC, SoC, module, or clearly bounded IP block." ;
    rdfs:subClassOf hw:HardwareEntity ;
    skos:example "SoC, DRAM module, NOR/NAND flash chip, discrete NIC, crypto co-processor, secure element, TPM, Bluetooth module." ;
    skos:scopeNote "Aligned to PLATOnt IC/SoC class hierarchy and CPE hardware CPE entries." .

# ── hw:SubComponent ─────────────────────────────────────────────

hw:SubComponent
    a owl:Class ;
    rdfs:label   "Sub-component" ;
    rdfs:comment "A named functional block within a Component, corresponding to an IP core or well-defined internal unit. Does not necessarily have a separate die or package." ;
    rdfs:subClassOf hw:HardwareEntity ;
    skos:example "CPU core, crypto engine, MMU, DMA controller, USB PHY, PCIe controller, hardware accelerator, PLL, TrustZone secure monitor, interrupt controller." .

# ── hw:Element ──────────────────────────────────────────────────

hw:Element
    a owl:Class ;
    rdfs:label   "Element" ;
    rdfs:comment "Atomic unit of decomposition — no further hardware breakdown is meaningful at this level. Typically a register, bit field, fuse row, key slot, or interrupt line." ;
    rdfs:subClassOf hw:HardwareEntity ;
    skos:example "Memory-mapped control register, OTP/eFuse bit field, hardware key slot, TRNG output register, interrupt line, GPIO pin, DMA channel descriptor." .


# ─────────────────────────────────────────────────────────────────
#  PART 2 — CROSS-CUTTING STRUCTURAL CLASSES  (hw: namespace)
# ─────────────────────────────────────────────────────────────────

# ── hw:Interface (abstract) ─────────────────────────────────────

hw:Interface
    a owl:Class ;
    rdfs:label   "Interface" ;
    rdfs:comment "Abstract superclass for communication boundaries between HardwareEntities, or between the device and the external world. Interfaces are the primary attack surface entry points and trust boundary crossings." ;
    rdfs:subClassOf owl:Thing .

# ── hw:PhysicalInterface ────────────────────────────────────────

hw:PhysicalInterface
    a owl:Class ;
    rdfs:label   "Physical interface" ;
    rdfs:comment "A physical connector, pin header, or test pad that provides direct hardware access. Typically requires physical proximity to exploit." ;
    rdfs:subClassOf hw:Interface ;
    skos:example "UART test pads, JTAG/SWD header, SPI flash clip point, USB port, SD card slot, PCIe edge connector, I2C/SMBus pins, RS-232 header." .

# ── hw:LogicalInterface ─────────────────────────────────────────

hw:LogicalInterface
    a owl:Class ;
    rdfs:label   "Logical interface" ;
    rdfs:comment "A software-visible boundary exposed by a HardwareEntity — typically a register map, shared memory region, hypervisor call gate, or bootloader command interface." ;
    rdfs:subClassOf hw:Interface ;
    skos:example "Memory-mapped I/O register map, bootloader interactive shell, TEE world-switch gate, PCIe BAR region, MMIO peripheral control interface." .

# ── hw:NetworkInterface ─────────────────────────────────────────

hw:NetworkInterface
    a owl:Class ;
    rdfs:label   "Network interface" ;
    rdfs:comment "A network-facing interface that may be reachable without physical access. Includes both wired and wireless technologies." ;
    rdfs:subClassOf hw:Interface ;
    skos:example "Ethernet (10/100/1000), WiFi 802.11, Bluetooth/BLE, LTE/5G modem, Zigbee, Z-Wave, CAN bus, LIN bus, PROFIBUS." ;
    skos:scopeNote "Aligned to D3FEND d3f:NetworkInterface." .

# ── hw:Firmware ─────────────────────────────────────────────────

hw:Firmware
    a owl:Class ;
    rdfs:label   "Firmware" ;
    rdfs:comment "Software stored in and executed on a HardwareEntity. Linked to an entity via hw:hasFirmware; not a subclass of HardwareEntity. Represents a versioned software artefact for analysis purposes." ;
    rdfs:subClassOf owl:Thing ;
    skos:example "U-Boot bootloader, Linux kernel image, SquashFS rootfs, TEE OS (OP-TEE, TEEGRIS), radio/modem firmware blob, MCU application firmware, UEFI BIOS." ;
    skos:scopeNote "Aligned to UCO uco-observable:Software and CybOX FileObject." .

# ── hw:TrustBoundary ────────────────────────────────────────────

hw:TrustBoundary
    a owl:Class ;
    rdfs:label   "Trust boundary" ;
    rdfs:comment "A boundary across which privilege or trust level changes. Defines the enforcement mechanism separating high-trust from low-trust execution contexts." ;
    rdfs:subClassOf owl:Thing ;
    skos:example "ARM TrustZone secure/normal world, hypervisor/guest VM boundary, CPU ring 0 / ring 3, TPM execution boundary, Intel SGX enclave, Qualcomm QSEE." ;
    skos:scopeNote "Aligned to D3FEND d3f:TrustedExecutionEnvironment." .


# ─────────────────────────────────────────────────────────────────
#  PART 3 — SECURITY ANNOTATION CLASSES  (sec: namespace)
# ─────────────────────────────────────────────────────────────────

# ── sec:SecurityProperty (abstract) ─────────────────────────────

sec:SecurityProperty
    a owl:Class ;
    rdfs:label   "Security property" ;
    rdfs:comment "Abstract superclass for all security annotations. Associated with HardwareEntity instances via hw:hasSecurityProperty. Do not instantiate directly." ;
    rdfs:subClassOf owl:Thing ;
    skos:scopeNote "Aligned to UCO uco-core:Annotation." .

# ── sec:AttackSurface ───────────────────────────────────────────

sec:AttackSurface
    a owl:Class ;
    rdfs:label   "Attack surface" ;
    rdfs:comment "Characterises how and from where an attacker can reach a HardwareEntity — covering access vector, authentication requirements, and remote exploitability. Individual instances link to ATT&CK techniques and CAPEC attack patterns." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:scopeNote "Link instances to ATT&CK technique IRIs and CAPEC attack-pattern IRIs via sec:mapsToATTACK and sec:mapsToCAPEC." .

# ── sec:DebugAccess ─────────────────────────────────────────────

sec:DebugAccess
    a owl:Class ;
    rdfs:label   "Debug access" ;
    rdfs:comment "Describes debug and diagnostic interfaces present on a HardwareEntity that may expose privileged access beyond normal operational channels. Captures the current lock state and known bypass techniques." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:scopeNote "Aligned to CWE-1244 (internal state exposed via debug interface) and CWE-1191 (on-chip debug interface with improper access control)." .

# ── sec:SideChannel ─────────────────────────────────────────────

sec:SideChannel
    a owl:Class ;
    rdfs:label   "Side-channel" ;
    rdfs:comment "Describes an information leakage path that arises from physical implementation properties rather than logical design flaws. Covers timing, power, electromagnetic, and acoustic channels." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:example "DPA (differential power analysis) against AES engine, cache-timing leakage from shared L2, EM emission from crypto accelerator, acoustic covert channel." ;
    skos:scopeNote "Aligned to CWE-1300 (improper protection of physical side channels) and CWE-208 (observable timing discrepancy)." .

# ── sec:FaultInjection ──────────────────────────────────────────

sec:FaultInjection
    a owl:Class ;
    rdfs:label   "Fault injection" ;
    rdfs:comment "Describes susceptibility to externally induced faults (glitching) that alter the device's intended behaviour. Covers voltage glitching, clock glitching, laser fault injection, and electromagnetic fault injection." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:example "Voltage glitch bypassing secure boot signature check, clock glitch skipping AES round, laser FI flipping branch condition in bootloader." ;
    skos:scopeNote "Aligned to CWE-1384 (improper handling of hardware behavior in exceptional conditions)." .

# ── sec:Vulnerability ───────────────────────────────────────────

sec:Vulnerability
    a owl:Class ;
    rdfs:label   "Vulnerability" ;
    rdfs:comment "A specific weakness instance present in a HardwareEntity. Linkable to a CWE weakness class and one or more CVE entries. Supports CVSS v3.1 base scoring." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:scopeNote "Link to CWE via sec:mapsToCWE and to CVE entries via sec:mapsToCVE. CVSS score expressed as sec:cvssBaseScore." .

# ── sec:Countermeasure ──────────────────────────────────────────

sec:Countermeasure
    a owl:Class ;
    rdfs:label   "Countermeasure" ;
    rdfs:comment "A defensive control applied to or protecting a HardwareEntity. Instances link to D3FEND defensive technique IRIs for structured representation compatible with the MITRE ecosystem." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:scopeNote "Link to D3FEND techniques via sec:mapsToD3FEND." .

# ── sec:ThreatModel ─────────────────────────────────────────────

sec:ThreatModel
    a owl:Class ;
    rdfs:label   "Threat model" ;
    rdfs:comment "A scoped threat model entry associated with a HardwareEntity, capturing the assumed adversary capability and the identified threat scenario." ;
    rdfs:subClassOf sec:SecurityProperty ;
    skos:example "Remote unauthenticated attacker exploiting WAN-facing service; insider with physical access to PCB; supply-chain adversary with firmware signing capability." .


# ─────────────────────────────────────────────────────────────────
#  PART 4 — OBJECT PROPERTIES
# ─────────────────────────────────────────────────────────────────

# ── Composition chain ────────────────────────────────────────────

hw:hasSubsystem
    a owl:ObjectProperty ;
    rdfs:label   "has subsystem" ;
    rdfs:comment "Associates a System with one or more Subsystems." ;
    rdfs:domain  hw:System ;
    rdfs:range   hw:Subsystem .

hw:hasComponent
    a owl:ObjectProperty ;
    rdfs:label   "has component" ;
    rdfs:comment "Associates a Subsystem with one or more Components." ;
    rdfs:domain  hw:Subsystem ;
    rdfs:range   hw:Component .

hw:hasSubComponent
    a owl:ObjectProperty ;
    rdfs:label   "has sub-component" ;
    rdfs:comment "Associates a Component with one or more SubComponents." ;
    rdfs:domain  hw:Component ;
    rdfs:range   hw:SubComponent .

hw:hasElement
    a owl:ObjectProperty ;
    rdfs:label   "has element" ;
    rdfs:comment "Associates a SubComponent with one or more Elements." ;
    rdfs:domain  hw:SubComponent ;
    rdfs:range   hw:Element .

# ── Cross-cutting structural properties ──────────────────────────

hw:hasInterface
    a owl:ObjectProperty ;
    rdfs:label   "has interface" ;
    rdfs:comment "Associates any HardwareEntity with an Interface it exposes." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   hw:Interface .

hw:hasFirmware
    a owl:ObjectProperty ;
    rdfs:label   "has firmware" ;
    rdfs:comment "Associates a HardwareEntity with Firmware that it stores or executes." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   hw:Firmware .

hw:hasTrustBoundary
    a owl:ObjectProperty ;
    rdfs:label   "has trust boundary" ;
    rdfs:comment "Associates a HardwareEntity with a TrustBoundary that it enforces or participates in." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   hw:TrustBoundary .

hw:hasSecurityProperty
    a owl:ObjectProperty ;
    rdfs:label   "has security property" ;
    rdfs:comment "Associates any HardwareEntity with a security annotation (AttackSurface, Vulnerability, Countermeasure, etc.)." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   sec:SecurityProperty .

hw:crossesTrustBoundary
    a owl:ObjectProperty ;
    rdfs:label   "crosses trust boundary" ;
    rdfs:comment "Indicates that an Interface crosses a named TrustBoundary." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   hw:TrustBoundary .

hw:interactsWith
    a owl:ObjectProperty ,
      owl:SymmetricProperty ;
    rdfs:label   "interacts with" ;
    rdfs:comment "Symmetric property capturing a peer communication or dependency relationship between two HardwareEntities at the same level." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   hw:HardwareEntity .

hw:physicallyContains
    a owl:ObjectProperty ,
      owl:TransitiveProperty ;
    rdfs:label   "physically contains" ;
    rdfs:comment "Transitive property asserting that one entity is physically enclosed by another. Subsumes the composition chain for physical containment queries." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   hw:HardwareEntity .

# ── Security annotation object properties ────────────────────────

sec:mapsToATTACK
    a owl:ObjectProperty ;
    rdfs:label   "maps to ATT&CK technique" ;
    rdfs:comment "Links an AttackSurface annotation to one or more MITRE ATT&CK technique IRIs." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   rdfs:Resource .

sec:mapsToCAPEC
    a owl:ObjectProperty ;
    rdfs:label   "maps to CAPEC" ;
    rdfs:comment "Links an AttackSurface annotation to one or more CAPEC attack-pattern IRIs." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   rdfs:Resource .

sec:mapsToCWE
    a owl:ObjectProperty ;
    rdfs:label   "maps to CWE" ;
    rdfs:comment "Links a Vulnerability instance to its CWE weakness class IRI." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   rdfs:Resource .

sec:mapsToCVE
    a owl:ObjectProperty ;
    rdfs:label   "maps to CVE" ;
    rdfs:comment "Links a Vulnerability instance to one or more CVE entry IRIs in the NVD." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   rdfs:Resource .

sec:mapsToD3FEND
    a owl:ObjectProperty ;
    rdfs:label   "maps to D3FEND technique" ;
    rdfs:comment "Links a Countermeasure instance to a MITRE D3FEND defensive technique IRI." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   rdfs:Resource .

sec:mitigates
    a owl:ObjectProperty ;
    rdfs:label   "mitigates" ;
    rdfs:comment "Asserts that a Countermeasure reduces the risk of a specific Vulnerability." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   sec:Vulnerability .

sec:exploits
    a owl:ObjectProperty ;
    rdfs:label   "exploits" ;
    rdfs:comment "Asserts that a ThreatModel scenario exploits a specific Vulnerability or AttackSurface." ;
    rdfs:domain  sec:ThreatModel ;
    rdfs:range   sec:SecurityProperty .


# ─────────────────────────────────────────────────────────────────
#  PART 5 — DATA PROPERTIES
# ─────────────────────────────────────────────────────────────────

# ── Shared / inherited data properties on hw:HardwareEntity ──────

hw:manufacturer
    a owl:DatatypeProperty ;
    rdfs:label   "manufacturer" ;
    rdfs:comment "Name of the entity or company that manufactured this hardware unit." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:string .

hw:partNumber
    a owl:DatatypeProperty ;
    rdfs:label   "part number" ;
    rdfs:comment "Manufacturer part number or component identifier." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:string .

hw:description
    a owl:DatatypeProperty ;
    rdfs:label   "description" ;
    rdfs:comment "Free-text description of the entity's function in the system." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:string .

hw:trustLevel
    a owl:DatatypeProperty ;
    rdfs:label   "trust level" ;
    rdfs:comment "Ordinal trust level assigned to this entity during threat modelling. 0 = fully untrusted (external world), 5 = fully trusted (isolated, verified hardware root of trust)." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:integer .

hw:cpeUri
    a owl:DatatypeProperty ;
    rdfs:label   "CPE URI" ;
    rdfs:comment "Common Platform Enumeration formatted name for this entity, enabling lookup in the NVD. Format: cpe:/h:vendor:product:version." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:string .

hw:notes
    a owl:DatatypeProperty ;
    rdfs:label   "notes" ;
    rdfs:comment "Free-text analyst notes or observations about this entity." ;
    rdfs:domain  hw:HardwareEntity ;
    rdfs:range   xsd:string .

# ── hw:System data properties ────────────────────────────────────

hw:model
    a owl:DatatypeProperty ;
    rdfs:label   "model" ;
    rdfs:domain  hw:System ;
    rdfs:range   xsd:string .

hw:serialNumber
    a owl:DatatypeProperty ;
    rdfs:label   "serial number" ;
    rdfs:domain  hw:System ;
    rdfs:range   xsd:string .

hw:firmwareVersion
    a owl:DatatypeProperty ;
    rdfs:label   "firmware version" ;
    rdfs:comment "Top-level firmware version string for the system (e.g. as reported by device UI or /proc/version)." ;
    rdfs:domain  hw:System ;
    rdfs:range   xsd:string .

hw:certifications
    a owl:DatatypeProperty ;
    rdfs:label   "certifications" ;
    rdfs:comment "Comma-separated list of applicable security certifications (e.g. FIPS 140-3, CC EAL4+, UL 2900)." ;
    rdfs:domain  hw:System ;
    rdfs:range   xsd:string .

hw:assessmentDate
    a owl:DatatypeProperty ;
    rdfs:label   "assessment date" ;
    rdfs:domain  hw:System ;
    rdfs:range   xsd:date .

# ── hw:Subsystem data properties ─────────────────────────────────

hw:function
    a owl:DatatypeProperty ;
    rdfs:label   "function" ;
    rdfs:comment "Brief description of the primary functional role of this Subsystem." ;
    rdfs:domain  hw:Subsystem ;
    rdfs:range   xsd:string .

hw:powerDomain
    a owl:DatatypeProperty ;
    rdfs:label   "power domain" ;
    rdfs:comment "Power rail or domain this Subsystem operates on (e.g. VCC_MAIN, VCC_AON, VCC_IO)." ;
    rdfs:domain  hw:Subsystem ;
    rdfs:range   xsd:string .

hw:isolationBoundary
    a owl:DatatypeProperty ;
    rdfs:label   "isolation boundary" ;
    rdfs:comment "True if this Subsystem is physically or logically isolated from the rest of the system (e.g. by a firewall, separate power domain, or airgap)." ;
    rdfs:domain  hw:Subsystem ;
    rdfs:range   xsd:boolean .

# ── hw:Component data properties ─────────────────────────────────

hw:architecture
    a owl:DatatypeProperty ;
    rdfs:label   "architecture" ;
    rdfs:comment "Processor or hardware architecture (e.g. ARM Cortex-A53, MIPS32r2, x86_64, RISC-V RV64GC)." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:string .

hw:packageType
    a owl:DatatypeProperty ;
    rdfs:label   "package type" ;
    rdfs:comment "Physical IC package format (e.g. BGA-528, QFN-48, SOP-8, WLCSP)." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:string .

hw:processNode
    a owl:DatatypeProperty ;
    rdfs:label   "process node" ;
    rdfs:comment "Semiconductor fabrication process node (e.g. 28nm TSMC, 5nm Samsung, 40nm UMC)." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:string .

hw:endOfLife
    a owl:DatatypeProperty ;
    rdfs:label   "end of life" ;
    rdfs:comment "Date on which the manufacturer ended security support for this component." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:date .

hw:hasSecureBoot
    a owl:DatatypeProperty ;
    rdfs:label   "has secure boot" ;
    rdfs:comment "True if this component implements a hardware-rooted secure boot chain." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:boolean .

hw:hasHardwareRng
    a owl:DatatypeProperty ;
    rdfs:label   "has hardware RNG" ;
    rdfs:comment "True if this component includes a hardware true random number generator." ;
    rdfs:domain  hw:Component ;
    rdfs:range   xsd:boolean .

# ── hw:SubComponent data properties ──────────────────────────────

hw:ipBlock
    a owl:DatatypeProperty ;
    rdfs:label   "IP block" ;
    rdfs:comment "Name or identifier of the silicon IP block (e.g. ARM Cortex-M33, Synopsys DWC USB3, Cadence PCIe Gen3)." ;
    rdfs:domain  hw:SubComponent ;
    rdfs:range   xsd:string .

hw:clockDomain
    a owl:DatatypeProperty ;
    rdfs:label   "clock domain" ;
    rdfs:comment "Clock source or domain this block operates in (e.g. APLL_CLK, XTAL_32K, AXI_BUS_CLK)." ;
    rdfs:domain  hw:SubComponent ;
    rdfs:range   xsd:string .

hw:privilegeLevel
    a owl:DatatypeProperty ;
    rdfs:label   "privilege level" ;
    rdfs:comment "Minimum privilege level required to access or control this block (e.g. EL3, EL1, Ring0, SecureWorld, UserMode)." ;
    rdfs:domain  hw:SubComponent ;
    rdfs:range   xsd:string .

hw:isShared
    a owl:DatatypeProperty ;
    rdfs:label   "is shared" ;
    rdfs:comment "True if this SubComponent is shared between multiple trust domains or privilege levels (e.g. shared L2 cache, shared DMA controller)." ;
    rdfs:domain  hw:SubComponent ;
    rdfs:range   xsd:boolean .

# ── hw:Element data properties ───────────────────────────────────

hw:address
    a owl:DatatypeProperty ;
    rdfs:label   "address" ;
    rdfs:comment "Base memory-mapped address of this Element expressed as a hex value." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:hexBinary .

hw:bitWidth
    a owl:DatatypeProperty ;
    rdfs:label   "bit width" ;
    rdfs:comment "Width of the register or bit field in bits." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:integer .

hw:accessRights
    a owl:DatatypeProperty ;
    rdfs:label   "access rights" ;
    rdfs:comment "Permitted access modes for this Element. Allowed values: RO (read-only), RW (read-write), WO (write-only), CLEAR (write-to-clear), NONE (no-access)." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:string .

hw:resetValue
    a owl:DatatypeProperty ;
    rdfs:label   "reset value" ;
    rdfs:comment "Default value of this register or bit field after hardware reset, as a hex value." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:hexBinary .

hw:isVolatile
    a owl:DatatypeProperty ;
    rdfs:label   "is volatile" ;
    rdfs:comment "True if the value of this Element may change without a software write (e.g. status registers, FIFOs, hardware counters)." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:boolean .

hw:isLocked
    a owl:DatatypeProperty ;
    rdfs:label   "is locked" ;
    rdfs:comment "True if this Element (e.g. an eFuse or configuration register) is permanently or temporarily locked against further writes." ;
    rdfs:domain  hw:Element ;
    rdfs:range   xsd:boolean .

# ── hw:Interface data properties ─────────────────────────────────

hw:protocol
    a owl:DatatypeProperty ;
    rdfs:label   "protocol" ;
    rdfs:comment "Communication protocol used on this interface (e.g. UART, SPI, I2C, JTAG, USB 2.0, PCIe Gen3, 802.11ax)." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   xsd:string .

hw:isExternallyAccessible
    a owl:DatatypeProperty ;
    rdfs:label   "is externally accessible" ;
    rdfs:comment "True if this interface is accessible to an attacker without opening or modifying the device enclosure." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   xsd:boolean .

hw:requiresAuthentication
    a owl:DatatypeProperty ;
    rdfs:label   "requires authentication" ;
    rdfs:comment "True if access to this interface requires successful authentication before use." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   xsd:boolean .

hw:voltage
    a owl:DatatypeProperty ;
    rdfs:label   "voltage" ;
    rdfs:comment "Operating voltage level of this interface in volts (e.g. 3.3, 1.8, 0.9)." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   xsd:decimal .

hw:speed
    a owl:DatatypeProperty ;
    rdfs:label   "speed" ;
    rdfs:comment "Maximum data rate or clock speed of this interface (e.g. 115200 baud, 50 MHz, 480 Mbps)." ;
    rdfs:domain  hw:Interface ;
    rdfs:range   xsd:string .

hw:pinout
    a owl:DatatypeProperty ;
    rdfs:label   "pinout" ;
    rdfs:comment "Pin or pad assignment description for a PhysicalInterface (e.g. 'Pin 1: VCC, Pin 2: GND, Pin 3: TX, Pin 4: RX')." ;
    rdfs:domain  hw:PhysicalInterface ;
    rdfs:range   xsd:string .

hw:boardLocation
    a owl:DatatypeProperty ;
    rdfs:label   "board location" ;
    rdfs:comment "Location of this PhysicalInterface on the PCB (e.g. 'J3 header, bottom-left near SoC U1', 'TP17/TP18 adjacent to U4')." ;
    rdfs:domain  hw:PhysicalInterface ;
    rdfs:range   xsd:string .

hw:probeRequired
    a owl:DatatypeProperty ;
    rdfs:label   "probe required" ;
    rdfs:comment "True if connecting to this PhysicalInterface requires a probe, clip, or soldering rather than a standard connector." ;
    rdfs:domain  hw:PhysicalInterface ;
    rdfs:range   xsd:boolean .

hw:memoryBase
    a owl:DatatypeProperty ;
    rdfs:label   "memory base address" ;
    rdfs:comment "Base address of the memory region corresponding to this LogicalInterface." ;
    rdfs:domain  hw:LogicalInterface ;
    rdfs:range   xsd:hexBinary .

hw:accessControl
    a owl:DatatypeProperty ;
    rdfs:label   "access control" ;
    rdfs:comment "Access control mechanism protecting this LogicalInterface (e.g. privilege level check, MPU region, firewall rule, SMMU mapping)." ;
    rdfs:domain  hw:LogicalInterface ;
    rdfs:range   xsd:string .

hw:sanitisesInput
    a owl:DatatypeProperty ;
    rdfs:label   "sanitises input" ;
    rdfs:comment "True if this LogicalInterface performs validated sanitisation of all inputs before processing." ;
    rdfs:domain  hw:LogicalInterface ;
    rdfs:range   xsd:boolean .

hw:macAddress
    a owl:DatatypeProperty ;
    rdfs:label   "MAC address" ;
    rdfs:domain  hw:NetworkInterface ;
    rdfs:range   xsd:string .

hw:encryptionMode
    a owl:DatatypeProperty ;
    rdfs:label   "encryption mode" ;
    rdfs:comment "Encryption protocol or cipher suite used on this NetworkInterface (e.g. WPA3-SAE, TLS 1.3, MACsec AES-256-GCM)." ;
    rdfs:domain  hw:NetworkInterface ;
    rdfs:range   xsd:string .

hw:remotelyReachable
    a owl:DatatypeProperty ;
    rdfs:label   "remotely reachable" ;
    rdfs:comment "True if this NetworkInterface is reachable from the internet or an untrusted remote network without physical access." ;
    rdfs:domain  hw:NetworkInterface ;
    rdfs:range   xsd:boolean .

hw:wirelessRange
    a owl:DatatypeProperty ;
    rdfs:label   "wireless range" ;
    rdfs:comment "Approximate operational range of this wireless NetworkInterface (e.g. '10m BLE', '100m 802.11ac', '1km LoRa')." ;
    rdfs:domain  hw:NetworkInterface ;
    rdfs:range   xsd:string .

# ── hw:Firmware data properties ──────────────────────────────────

hw:firmwareBinaryVersion
    a owl:DatatypeProperty ;
    rdfs:label   "firmware binary version" ;
    rdfs:comment "Version string of this specific firmware artefact." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:string .

hw:hashSHA256
    a owl:DatatypeProperty ;
    rdfs:label   "SHA-256 hash" ;
    rdfs:comment "SHA-256 digest of the firmware binary image." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:hexBinary .

hw:isSignatureVerified
    a owl:DatatypeProperty ;
    rdfs:label   "is signature verified" ;
    rdfs:comment "True if the firmware image is cryptographically signed and the signature has been verified against a hardware-rooted trust anchor." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:boolean .

hw:extractionMethod
    a owl:DatatypeProperty ;
    rdfs:label   "extraction method" ;
    rdfs:comment "Method used to obtain the firmware image (e.g. OTA download, UART bootloader, SPI clip, JTAG memory dump, filesystem archive)." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:string .

hw:binaryFormat
    a owl:DatatypeProperty ;
    rdfs:label   "binary format" ;
    rdfs:comment "File or image format of the firmware binary (e.g. ELF, SquashFS, UBI, JFFS2, raw binary, SREC)." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:string .

hw:compilerFlags
    a owl:DatatypeProperty ;
    rdfs:label   "compiler flags" ;
    rdfs:comment "Security-relevant compiler flags identified in the binary (e.g. -fstack-protector, -D_FORTIFY_SOURCE=2, PIE, RELRO)." ;
    rdfs:domain  hw:Firmware ;
    rdfs:range   xsd:string .

# ── hw:TrustBoundary data properties ─────────────────────────────

hw:boundaryMechanism
    a owl:DatatypeProperty ;
    rdfs:label   "boundary mechanism" ;
    rdfs:comment "Hardware or architectural mechanism that enforces this trust boundary (e.g. ARM TrustZone SCR.NS bit, Intel VT-x EPT, SMMU/IOMMU, hardware firewall, fuse-based partition)." ;
    rdfs:domain  hw:TrustBoundary ;
    rdfs:range   xsd:string .

hw:bypassKnown
    a owl:DatatypeProperty ;
    rdfs:label   "bypass known" ;
    rdfs:comment "True if a publicly known or researcher-identified bypass technique exists for this trust boundary." ;
    rdfs:domain  hw:TrustBoundary ;
    rdfs:range   xsd:boolean .

hw:boundaryBypassCveRef
    a owl:DatatypeProperty ;
    rdfs:label   "bypass CVE reference" ;
    rdfs:comment "URI of a CVE entry documenting a known bypass of this trust boundary." ;
    rdfs:domain  hw:TrustBoundary ;
    rdfs:range   xsd:anyURI .

hw:enforcedByHardware
    a owl:DatatypeProperty ;
    rdfs:label   "enforced by hardware" ;
    rdfs:comment "True if this boundary is enforced exclusively in hardware, with no software-configurable override path." ;
    rdfs:domain  hw:TrustBoundary ;
    rdfs:range   xsd:boolean .

# ── sec:AttackSurface data properties ────────────────────────────

sec:accessVector
    a owl:DatatypeProperty ;
    rdfs:label   "access vector" ;
    rdfs:comment "How an attacker reaches the entity. Mirrors CVSS access vector. Allowed values: NETWORK, ADJACENT, LOCAL, PHYSICAL." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   xsd:string .

sec:authenticated
    a owl:DatatypeProperty ;
    rdfs:label   "authenticated" ;
    rdfs:comment "True if exploitation requires the attacker to have valid credentials or an established session on the target." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   xsd:boolean .

sec:remotelyExploitable
    a owl:DatatypeProperty ;
    rdfs:label   "remotely exploitable" ;
    rdfs:comment "True if this attack surface can be exploited without physical access to the device." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   xsd:boolean .

sec:complexity
    a owl:DatatypeProperty ;
    rdfs:label   "complexity" ;
    rdfs:comment "Attack complexity. Mirrors CVSS attack complexity. Allowed values: LOW, HIGH." ;
    rdfs:domain  sec:AttackSurface ;
    rdfs:range   xsd:string .

# ── sec:DebugAccess data properties ──────────────────────────────

sec:interfaceType
    a owl:DatatypeProperty ;
    rdfs:label   "interface type" ;
    rdfs:comment "Type of debug interface (e.g. JTAG, SWD, UART, I2C, vendor-specific)." ;
    rdfs:domain  sec:DebugAccess ;
    rdfs:range   xsd:string .

sec:debugIsLocked
    a owl:DatatypeProperty ;
    rdfs:label   "is locked" ;
    rdfs:comment "True if this debug interface is locked against use without a valid credential or challenge-response." ;
    rdfs:domain  sec:DebugAccess ;
    rdfs:range   xsd:boolean .

sec:requiresPhysicalAccess
    a owl:DatatypeProperty ;
    rdfs:label   "requires physical access" ;
    rdfs:comment "True if exploiting this debug interface requires physical access to the device or PCB." ;
    rdfs:domain  sec:DebugAccess ;
    rdfs:range   xsd:boolean .

sec:bypassTechnique
    a owl:DatatypeProperty ;
    rdfs:label   "bypass technique" ;
    rdfs:comment "Free-text description of any known technique for bypassing the lock or disabling authentication on this debug interface." ;
    rdfs:domain  sec:DebugAccess ;
    rdfs:range   xsd:string .

# ── sec:SideChannel data properties ──────────────────────────────

sec:channelType
    a owl:DatatypeProperty ;
    rdfs:label   "channel type" ;
    rdfs:comment "Physical side-channel medium. Allowed values: TIMING, POWER, EM, ACOUSTIC, THERMAL, CACHE." ;
    rdfs:domain  sec:SideChannel ;
    rdfs:range   xsd:string .

sec:measuredLeakage
    a owl:DatatypeProperty ;
    rdfs:label   "measured leakage" ;
    rdfs:comment "True if information leakage through this channel has been empirically confirmed (e.g. via oscilloscope trace, t-test, correlation attack)." ;
    rdfs:domain  sec:SideChannel ;
    rdfs:range   xsd:boolean .

sec:requiredEquipment
    a owl:DatatypeProperty ;
    rdfs:label   "required equipment" ;
    rdfs:comment "Equipment required to exploit this side channel (e.g. oscilloscope + current shunt, near-field EM probe, software-defined radio)." ;
    rdfs:domain  sec:SideChannel ;
    rdfs:range   xsd:string .

# ── sec:FaultInjection data properties ───────────────────────────

sec:faultType
    a owl:DatatypeProperty ;
    rdfs:label   "fault type" ;
    rdfs:comment "Type of fault injection technique. Allowed values: VOLTAGE_GLITCH, CLOCK_GLITCH, LASER, EM_FAULT, ROWHAMMER, OPTICAL." ;
    rdfs:domain  sec:FaultInjection ;
    rdfs:range   xsd:string .

sec:targetedBehaviour
    a owl:DatatypeProperty ;
    rdfs:label   "targeted behaviour" ;
    rdfs:comment "The specific hardware or firmware behaviour the attacker seeks to alter (e.g. signature verification skip, AES round corruption, branch condition flip)." ;
    rdfs:domain  sec:FaultInjection ;
    rdfs:range   xsd:string .

sec:successRate
    a owl:DatatypeProperty ;
    rdfs:label   "success rate" ;
    rdfs:comment "Empirical or estimated probability of successful fault injection (0.0–1.0)." ;
    rdfs:domain  sec:FaultInjection ;
    rdfs:range   xsd:decimal .

# ── sec:Vulnerability data properties ────────────────────────────

sec:cvssBaseScore
    a owl:DatatypeProperty ;
    rdfs:label   "CVSS base score" ;
    rdfs:comment "CVSS v3.1 base score for this vulnerability (0.0–10.0)." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   xsd:decimal .

sec:exploitAvailable
    a owl:DatatypeProperty ;
    rdfs:label   "exploit available" ;
    rdfs:comment "True if a public or private proof-of-concept exploit exists for this vulnerability." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   xsd:boolean .

sec:patchAvailable
    a owl:DatatypeProperty ;
    rdfs:label   "patch available" ;
    rdfs:comment "True if a vendor-issued patch or firmware update addressing this vulnerability is publicly available." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   xsd:boolean .

sec:discoveryMethod
    a owl:DatatypeProperty ;
    rdfs:label   "discovery method" ;
    rdfs:comment "Technique used to discover this vulnerability. Allowed values: FUZZING, SIDE_CHANNEL, FAULT_INJECTION, BINARY_ANALYSIS, MANUAL_REVIEW, DIFFERENTIAL_ANALYSIS, VENDOR_DISCLOSURE." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   xsd:string .

sec:disclosureDate
    a owl:DatatypeProperty ;
    rdfs:label   "disclosure date" ;
    rdfs:comment "Date of public disclosure of this vulnerability." ;
    rdfs:domain  sec:Vulnerability ;
    rdfs:range   xsd:date .

# ── sec:Countermeasure data properties ───────────────────────────

sec:controlType
    a owl:DatatypeProperty ;
    rdfs:label   "control type" ;
    rdfs:comment "NIST SP 800-53 / NIST CSF phase of this countermeasure. Allowed values: PREVENT, DETECT, RESPOND, RECOVER." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   xsd:string .

sec:effectiveness
    a owl:DatatypeProperty ;
    rdfs:label   "effectiveness" ;
    rdfs:comment "Qualitative effectiveness rating of this countermeasure. Allowed values: HIGH, MEDIUM, LOW, PARTIAL." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   xsd:string .

sec:isImplemented
    a owl:DatatypeProperty ;
    rdfs:label   "is implemented" ;
    rdfs:comment "True if this countermeasure is currently deployed on the target system." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   xsd:boolean .

sec:implementationCost
    a owl:DatatypeProperty ;
    rdfs:label   "implementation cost" ;
    rdfs:comment "Qualitative implementation cost. Allowed values: LOW, MEDIUM, HIGH." ;
    rdfs:domain  sec:Countermeasure ;
    rdfs:range   xsd:string .

# ── sec:ThreatModel data properties ──────────────────────────────

sec:adversaryProfile
    a owl:DatatypeProperty ;
    rdfs:label   "adversary profile" ;
    rdfs:comment "Description of the assumed adversary capability (e.g. 'Nation-state with physical device access', 'Remote unauthenticated user', 'Insider with production firmware signing key')." ;
    rdfs:domain  sec:ThreatModel ;
    rdfs:range   xsd:string .

sec:threatScenario
    a owl:DatatypeProperty ;
    rdfs:label   "threat scenario" ;
    rdfs:comment "Free-text narrative of the threat scenario and its potential impact." ;
    rdfs:domain  sec:ThreatModel ;
    rdfs:range   xsd:string .

sec:likelihood
    a owl:DatatypeProperty ;
    rdfs:label   "likelihood" ;
    rdfs:comment "Estimated likelihood of this threat scenario being realised. Allowed values: LOW, MEDIUM, HIGH." ;
    rdfs:domain  sec:ThreatModel ;
    rdfs:range   xsd:string .

sec:impact
    a owl:DatatypeProperty ;
    rdfs:label   "impact" ;
    rdfs:comment "Estimated security impact if this threat scenario is realised. Allowed values: LOW, MEDIUM, HIGH, CRITICAL." ;
    rdfs:domain  sec:ThreatModel ;
    rdfs:range   xsd:string .


# ─────────────────────────────────────────────────────────────────
#  PART 6 — OWL RESTRICTIONS (class-level constraints)
# ─────────────────────────────────────────────────────────────────

hw:System
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty  hw:trustLevel ;
        owl:maxCardinality 1
    ] .

hw:Element
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty hw:hasElement ;
        owl:maxCardinality 0
    ] .

sec:Vulnerability
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty  sec:cvssBaseScore ;
        owl:maxCardinality 1
    ] .

# ─────────────────────────────────────────────────────────────────
#  End of hwsec-ontology.ttl
# ─────────────────────────────────────────────────────────────────
