
@prefix tg: <http://trustgraph.ai/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### ==========================================
###   1. ONTOLOGY DEFINITION
### ==========================================

tg:RiskManagementOntology rdf:type owl:Ontology ;
    rdfs:label "TrustGraph Risk Management Ontology" ;
    rdfs:comment "A streamlined, event-centric ontology designed for enterprise risk tracking, optimization, and visualization." .

### ==========================================
###   2. CLASSES (The 4 Core Nodes)
### ==========================================

tg:Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "The central hub capturing a specific risk occurrence or observation at a point in time." .

tg:Actor rdf:type owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "The internal or external entity bringing about the risk." .

tg:Risk rdf:type owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "The vulnerability, threat event, or mechanism of harm." .

tg:Asset rdf:type owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "The corporate resource, system, or entity at stake." .

### ==========================================
###   3. OBJECT PROPERTIES (Relationships)
### ==========================================

tg:hasActor rdf:type owl:ObjectProperty ;
    rdfs:label "has actor" ;
    rdfs:comment "Links the risk event to the specific entity responsible for initiating it." ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Actor .

tg:hasRisk rdf:type owl:ObjectProperty ;
    rdfs:label "has risk" ;
    rdfs:comment "Links the risk event to the underlying classification or mechanism of risk." ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Risk .

tg:impactsAsset rdf:type owl:ObjectProperty ;
    rdfs:label "impacts asset" ;
    rdfs:comment "Links the risk event to one or more assets currently exposed or compromised." ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Asset .

### ==========================================
###   4. DATATYPE PROPERTIES (Attributes)
### ==========================================

tg:timestamp rdf:type owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:comment "The exact, fine-grained date and time the risk event occurred." ;
    rdfs:domain tg:Event ;
    rdfs:range xsd:dateTime .

tg:eventDate rdf:type owl:DatatypeProperty ;
    rdfs:label "event date" ;
    rdfs:comment "Optimization property containing only the calendar date, used for high-speed primary index filtering." ;
    rdfs:domain tg:Event ;
    rdfs:range xsd:date .

tg:riskScore rdf:type owl:DatatypeProperty ;
    rdfs:label "risk score" ;
    rdfs:comment "A normalized risk calculation score ranging from 0.0 to 1.0." ;
    rdfs:domain tg:Risk ;
    rdfs:range xsd:float .

