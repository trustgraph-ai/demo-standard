@prefix tg: <http://trustgraph.ai/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### ==========================================
###   1. ONTOLOGY DEFINITION
### ==========================================

tg:RiskManagementOntology rdf:type owl:Ontology ;
    rdfs:label "TrustGraph Risk Management Ontology" ;
    rdfs:comment "A streamlined, event-centric ontology designed for enterprise risk tracking, optimization, governance, and interactive mitigation workflows with clear accountability." .

### ==========================================
###   2. CLASSES (The 6 Core Nodes)
### ==========================================

tg:Event rdf:type owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "The central hub capturing a specific risk occurrence or observation at a point in time." .

tg:Actor rdf:type owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "The internal or external entity bringing about the risk." .

tg:Risk rdf:type owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "The vulnerability, threat event, or mechanism of harm." .

tg:Asset rdf:type owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "The corporate resource, system, or entity at stake." .

tg:Process rdf:type owl:Class ;
    rdfs:label "Process" ;
    rdfs:comment "A governance, incident response, or mitigation workflow invoked to manage or resolve risk." .

tg:ProcessStep rdf:type owl:Class ;
    rdfs:label "Process Step" ;
    rdfs:comment "A specific task or action item within a larger risk mitigation process." .

### ==========================================
###   3. OBJECT PROPERTIES (Relationships)
### ==========================================

tg:hasActor rdf:type owl:ObjectProperty ;
    rdfs:label "has actor" ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Actor .

tg:hasRisk rdf:type owl:ObjectProperty ;
    rdfs:label "has risk" ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Risk .

tg:impactsAsset rdf:type owl:ObjectProperty ;
    rdfs:label "impacts asset" ;
    rdfs:domain tg:Event ;
    rdfs:range tg:Asset .

tg:mitigatesEvent rdf:type owl:ObjectProperty ;
    rdfs:label "mitigates event" ;
    rdfs:domain tg:Process ;
    rdfs:range tg:Event .

tg:hasStep rdf:type owl:ObjectProperty ;
    rdfs:label "has step" ;
    rdfs:domain tg:Process ;
    rdfs:range tg:ProcessStep .

### ==========================================
###   4. DATATYPE PROPERTIES (Attributes)
### ==========================================

# Temporal Properties
tg:timestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:Event ;
    rdfs:range xsd:dateTime .

tg:eventDate rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:Event ;
    rdfs:range xsd:date .

# Risk Metrics
tg:riskScore rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:Risk ;
    rdfs:range xsd:float .

# Process Metadata
tg:invokedBy rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:Process ;
    rdfs:range xsd:string .

tg:processStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:Process ;
    rdfs:range xsd:string .

# Step Metadata
tg:stepNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:ProcessStep ;
    rdfs:range xsd:integer .

tg:isComplete rdf:type owl:DatatypeProperty ;
    rdfs:domain tg:ProcessStep ;
    rdfs:range xsd:boolean .

# Accountability Property (Applicable to both Process and ProcessStep)
tg:assignedTo rdf:type owl:DatatypeProperty ;
    rdfs:label "assigned to" ;
    rdfs:comment "The individual or team responsible for owning the process or executing the specific step." ;
    rdfs:range xsd:string .

