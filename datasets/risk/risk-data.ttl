    tg:impactsAsset d:asset-customer-db .

d:event-008 a tg:Event ;
    rdfs:label "Credential stuffing attack on VPN gateway" ;
    tg:timestamp "2026-07-08T22:17:00"^^xsd:dateTime ;
    tg:eventDate "2026-07-08"^^xsd:date ;
    tg:hasActor d:actor-extern-unknown ;
    tg:hasRisk d:risk-credential-stuffing ;
