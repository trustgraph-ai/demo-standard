# =============================================================================
# Brands
# =============================================================================

b:Elgato a schema:Brand ;
    rdfs:label "Elgato" ;
    rdfs:comment "Elgato, a Corsair brand specialising in content creation and streaming tools." .

b:HyperX a schema:Brand ;
    rdfs:label "HyperX" ;
    rdfs:comment "HyperX, a gaming peripherals brand known for headsets, keyboards, and mice." .

b:ProMount a schema:Brand ;
    rdfs:label "ProMount" ;
    rdfs:comment "ProMount, manufacturer of action camera mounts and accessories." .

b:Blue a schema:Brand ;
    rdfs:label "Blue" ;
    rdfs:comment "Blue Microphones, a Logitech brand known for USB condenser microphones for streaming and podcasting." .

