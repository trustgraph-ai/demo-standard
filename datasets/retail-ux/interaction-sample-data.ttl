# =============================================================================
# Cross-journey signal: upgrade cliff pattern
#
# This signal spans multiple events in journey 2 and captures the overall
# pattern: user hit an upgrade cliff, the scope overwhelmed them, and
# they downscaled their purchase.
# =============================================================================

sig:upgrade-cliff-pattern a ix:AbandonmentSignal, ix:PrioritySignal ;
    rdfs:label "Upgrade cliff downscale pattern" ;
    rdfs:comment "The user's initial upgrade ambition was curtailed when they discovered the cascading cost of a platform change. The complexity and cost objections caused them to downscale from a high-end GPU + PSU upgrade to a mid-range GPU-only swap. This pattern — initial enthusiasm followed by scope shock leading to a reduced purchase — is a common upgrade journey outcome." ;
    ix:derivedFrom ev:upgrade-006 ;
    ix:derivedFrom ev:upgrade-010 ;
    ix:derivedFrom ev:upgrade-011 ;
    ix:priorityDimension "simplicity" ;
    ix:signalStrength "strong" .

# =============================================================================
# =============================================================================
#
# JOURNEY 3: GIFT RECOMMENDATION
#
# User needs a gift for a teenage nephew who is into gaming. Budget is
# under $100. Quick, decisive journey with a confidence check resolved
# by reassurance. Completes purchase.
#
# =============================================================================
# =============================================================================

# -----------------------------------------------------------------------------
# Actor
# -----------------------------------------------------------------------------

actor:user-003 a ix:Actor ;
    rdfs:label "User 003" ;
    rdfs:comment "Gift buyer, not a gamer themselves, moderate tech literacy. Wants a safe, appreciated gift." ;
    ix:actorId "user-003" ;
    ix:actorSegment "gift-buyer" ;
    ix:returningUser false ;
    ix:previousJourneyCount 0 .

# -----------------------------------------------------------------------------
# Journey and session
# -----------------------------------------------------------------------------

j:gift-for-nephew a ix:Journey ;
    rdfs:label "Gift for Nephew Journey" ;
    rdfs:comment "Short single-session journey. User finds a gift quickly with minimal deliberation." ;
