    ix:journeyOutcome "purchase" ;
    ix:journeyStartDate "2026-06-12T12:05:00Z"^^xsd:dateTime ;
    ix:journeyEndDate "2026-06-12T12:14:00Z"^^xsd:dateTime ;
    ix:hasSession sess:gift-session-1 .

sess:gift-session-1 a ix:Session ;
