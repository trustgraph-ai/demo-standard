# =============================================================================

p:coleman-classic-stove a rt:GearItem ;
    rdfs:label "Coleman Classic Propane Stove" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/camping-stove.jpg> ;
    rdfs:comment "Reliable two-burner camping stove producing 20,000 BTU total, running on standard 16-ounce propane canisters. Wind guards on both sides protect the flame in breezy conditions. Each burner has independent heat control for simultaneous cooking at different temperatures. Provides approximately 4 hours of runtime on high with a single propane canister." ;
    rt:productId "coleman-classic-stove" ;
    schema:brand b:Coleman ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:CookingCategory ;
    rt:price 58.99 ;
    rt:rating 4.7 ;
    rt:reviewCount 3201 ;
    rt:inStock true ;
    rt:tag "stove" ;
    rt:tag "camping" ;
    rt:tag "cooking" ;
    rt:giftSuitability "medium" .

p:coleman-propane-4pack a rt:Consumable ;
    rdfs:label "Coleman Propane Fuel 4-Pack" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/propane.jpg> ;
    rdfs:comment "Four 16-ounce propane cylinders with standard CGA 600 connection, compatible with Coleman stoves, lanterns, and other propane-powered camping equipment. Each canister provides approximately 4 hours of runtime on a two-burner stove at high heat. A 4-pack covers a typical weekend camping trip with cooking and lighting needs." ;
    rt:productId "coleman-propane-4pack" ;
    schema:brand b:Coleman ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:CookingCategory ;
    rt:price 18.99 ;
    rt:rating 4.8 ;
    rt:reviewCount 1234 ;
    rt:inStock true ;
    rt:tag "fuel" ;
    rt:tag "camping" ;
    rt:tag "propane" ;
    rt:giftSuitability "low" ;
    rt:isConsumableFor p:coleman-classic-stove .

p:gsi-cook-set a rt:GearItem ;
    rdfs:label "GSI Outdoors Camping Cook Set" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/propane-stove.jpg> ;
    rdfs:comment "Complete aluminium cook set for 3 to 4 people, including two nesting pots, four plates, four cups, and a set of utensils. The entire kit nests compactly into the larger pot for efficient packing. At 3.2 lbs total weight, it provides everything a small group needs for camp cooking without requiring individual cookware." ;
    rt:productId "gsi-cook-set" ;
    schema:brand b:GSIOutdoors ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:CookingCategory ;
    rt:price 34.99 ;
    rt:rating 4.6 ;
    rt:reviewCount 876 ;
    rt:inStock true ;
    rt:tag "cookware" ;
    rt:tag "camping" ;
    rt:tag "kitchen" ;
    rt:giftSuitability "medium" ;
    rt:worksWellWith p:coleman-classic-stove .

p:coleman-16qt-cooler a rt:GearItem ;
    rdfs:label "Coleman 16-Quart Cooler" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/cooler.jpg> ;
    rdfs:comment "Compact hard-sided cooler with 16-quart capacity, holding up to 22 cans. Keeps ice for up to 24 hours in outdoor temperatures. The hinged lid and bail handle make it easy to carry and access contents. At 3.4 lbs empty, it is the right size for a weekend trip without being burdensome to transport from car to campsite." ;
    rt:productId "coleman-16qt-cooler" ;
    schema:brand b:Coleman ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:CookingCategory ;
    rt:price 24.99 ;
