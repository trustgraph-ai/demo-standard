p:bear-canister-rental a rt:GearItem ;
    rdfs:label "Bear Canister Rental Voucher" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/bear-canister.jpg> ;
    rdfs:comment "Seven-day rental voucher for a USDA-certified bear-proof food storage container. Required by regulation in many national parks and wilderness areas including Yosemite, Sequoia, and parts of the Sierra Nevada. Holds approximately 7 days of food for a group of three. The canister is picked up and returned at a local outfitter near the trailhead." ;
