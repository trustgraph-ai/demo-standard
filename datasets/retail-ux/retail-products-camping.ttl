# =============================================================================
# Sleep system
# =============================================================================

p:coleman-sundome-3p a rt:GearItem ;
    rdfs:label "Coleman Sundome 3-Person Tent" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/tent1.jpg> ;
    rdfs:comment "Easy-setup dome tent for 3 people with Coleman's WeatherTec system featuring welded floors and inverted seams to keep rain out. Sets up in approximately 10 minutes. The 63 square foot floor area provides comfortable sleeping space for three adults. Weighs 16.5 lbs, making it well suited for car camping where weight is not a primary concern." ;
    rt:productId "coleman-sundome-3p" ;
    schema:brand b:Coleman ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:SleepSystemCategory ;
    rt:price 119.99 ;
    rt:rating 4.5 ;
    rt:reviewCount 2847 ;
    rt:inStock true ;
    rt:tag "tent" ;
    rt:tag "camping" ;
    rt:tag "car-camping" ;
    rt:tag "beginner-friendly" ;
    rt:giftSuitability "medium" .

p:teton-trailhead-sleeping-bag a rt:GearItem ;
    rdfs:label "Teton Sports TrailHead Sleeping Bag" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/sleeping-bag.jpg> ;
    rdfs:comment "Mummy-style sleeping bag rated to 20 degrees Fahrenheit (-7 degrees Celsius) with synthetic fill insulation. Comes with a compression sack for compact storage. The 84-inch length accommodates users up to 6 feet 2 inches tall. At 5 lbs, it balances warmth and portability for three-season use. An excellent budget option that punches above its price." ;
    rt:productId "teton-trailhead-sleeping-bag" ;
    schema:brand b:TetonSports ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:SleepSystemCategory ;
    rt:price 44.99 ;
    rt:rating 4.6 ;
    rt:reviewCount 1543 ;
    rt:inStock true ;
    rt:tag "sleeping-bag" ;
    rt:tag "camping" ;
    rt:tag "3-season" ;
    rt:giftSuitability "medium" .

p:intex-camping-mattress a rt:GearItem ;
    rdfs:label "Intex Camping Air Mattress" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/air-mattress.jpg> ;
    rdfs:comment "Twin-size durable air mattress with a waterproof flocked top surface that prevents sleeping bags from sliding. Features a built-in electric pump for easy inflation and deflation. The 9-inch thickness provides comfortable cushioning from uneven ground. Weighs 8 lbs, making it practical for car camping but too heavy for backpacking." ;
    rt:productId "intex-camping-mattress" ;
    schema:brand b:Intex ;
    rt:hasCategory rt:OutdoorGear ;
    rt:hasSubcategory rt:SleepSystemCategory ;
    rt:price 24.99 ;
    rt:rating 4.3 ;
    rt:reviewCount 892 ;
    rt:inStock true ;
    rt:tag "sleeping-pad" ;
    rt:tag "camping" ;
    rt:tag "comfort" ;
    rt:giftSuitability "medium" .

