p:black-diamond-headlamp-3pack a rt:GearItem ;
    rdfs:label "Black Diamond Headlamp 3-Pack" ;
    schema:image <https://raw.githubusercontent.com/trustgraph-ai/demo-standard/refs/heads/master/datasets/retail-ux/images/headlamp.jpg> ;
    rdfs:comment "Pack of three compact LED headlamps, each producing 200 lumens on the high setting. Features a red night-vision mode that preserves dark adaptation and avoids disturbing others in camp. IPX4 waterproof rating handles rain and splashes. Each headlamp runs on three AAA batteries (included) with up to 50 hours of runtime on the low setting." ;
    rt:productId "black-diamond-headlamp-3pack" ;
    schema:brand b:BlackDiamond ;
